EXPO_PUBLIC_AUTH_URL=http://192.168.1.243:5074/api/v1
EXPO_PUBLIC_FILES_URL=http://192.168.1.243:3003
EXPO_PUBLIC_NOTIFICATIONS_URL=http://192.168.1.243:3005/Biblioteca/v1

# Google reCAPTCHA v2 (checkbox) — misma Site Key que client-admin VITE_RECAPTCHA_SITE_KEY
# Crear en https://www.google.com/recaptcha/admin (v2 Checkbox)
# Secret: auth-service RecaptchaSettings:SecretKey + Enabled=true
# Vacío = omitido (__DEV__: aviso; release: login bloqueado)
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=

# Emulador Android: localhost funciona (se reemplaza por 10.0.2.2 en endpoints.js).
# Dispositivo físico / Expo Go en el teléfono: sustituye 192.168.1.243 por tu IPv4 (ipconfig).
# El PC y el móvil deben estar en la misma red Wi‑Fi.
# Tras cambiar .env: reinicia Expo con `pnpm start --clear`.
